NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
DEV_USER_ID=
# Dev-only: two-factor opt-in for DEV_USER_ID bypass. Requires BOTH
# NODE_ENV != 'production' AND ENABLE_DEV_AUTH='1' AND a valid DEV_USER_ID
# to activate. Without ENABLE_DEV_AUTH, the bypass is inert even in dev.
ENABLE_DEV_AUTH=
OPENAI_MODEL_ANALYSIS=gpt-4.1-mini
OPENAI_MODEL_CARD_GENERATION=gpt-4.1-mini
